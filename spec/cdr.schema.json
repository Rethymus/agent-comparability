{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cmp/cdr-0.3.schema.json",
  "title": "Comparison Decision Record (cmp/0.3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "requested_claim",
    "comparison_scope",
    "admissibility",
    "satisfied_conditions",
    "violated_conditions",
    "unknown_conditions",
    "supported_claims",
    "unsupported_claims",
    "evidence_refs",
    "policy_version",
    "limitations"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "requested_claim": {
      "type": "string"
    },
    "comparison_scope": {
      "type": "string"
    },
    "admissibility": {
      "enum": [
        "ADMISSIBLE",
        "INADMISSIBLE",
        "PARTIAL",
        "INCONCLUSIVE"
      ]
    },
    "satisfied_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "violated_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknown_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supported_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unsupported_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy_version": {
      "type": "string",
      "pattern": "^cmp/0\\.3(\\.1)?$"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "description": "必须包含防篡改声明",
      "contains": {
        "type": "string",
        "pattern": "抗恶意篡改|tamper"
      }
    }
  }
}
